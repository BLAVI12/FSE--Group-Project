NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only, never with NEXT_PUBLIC_. README.md, "Settings", explains each value.
# Transaction pooler address from Supabase > Connect (not the direct db. address),
# same project as the browser login.
DATABASE_URL=
# Required for the hosted Supabase database: Project Settings > Database > SSL
# Configuration > Download certificate. Put the whole PEM file in double quotes.
DATABASE_CA_CERT=
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=
TINK_REDIRECT_URI=http://localhost:3000/api/tink
TINK_MARKET=DE
TINK_LOCALE=en_US
# This app connects only to Demo Bank. Credentials are entered in Tink Link.
TINK_TEST_MODE=true
TINK_DEMO_PROVIDER=de-demobank-password
TINK_TIMEOUT_MS=20000
# Only for the scheduled sync (web/README.md, "Scheduled sync"): at least 32 random
# characters, the same value as the GitHub secret CRON_SECRET.
CRON_SECRET=
