NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: use the same Supabase project as the browser login.
DATABASE_URL=
# Optional PEM certificate when your database connection requires one.
DATABASE_CA_CERT=
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=
TINK_REDIRECT_URI=http://localhost:3000/api/tink
TINK_MARKET=DE
TINK_LOCALE=en_US
# This app connects only to Demo Bank. Credentials are entered in Tink Link.
TINK_TEST_MODE=true
TINK_DEMO_PROVIDER=de-demobank-password
TINK_TIMEOUT_MS=20000
